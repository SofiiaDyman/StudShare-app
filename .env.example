# Скопіюйте цей файл у корінь проєкту під назвою .env. Справжній .env не комітьте.

# MySQL у Docker; backend запускається окремо через npm.
DB_NAME=studshare
DB_USER=studshare
DB_PASSWORD=
DB_ROOT_PASSWORD=
JWT_SECRET=
DB_HOST=127.0.0.1
DB_PORT=3307
PORT=3000
ALLOWED_EMAIL_DOMAIN=lnu.edu.ua

# Згенеруйте окреме випадкове значення для кожного порожнього секрету вище:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Запуск: docker compose up -d, потім у backend виконайте npm run dev.

# SMTP необов'язковий. Якщо SMTP_HOST порожній, код виводиться в лог backend.
# Для Gmail вкажіть smtp.gmail.com і пароль застосунку без пробілів.
SMTP_HOST=
# Порт 587 — STARTTLS, порт 465 — TLS.
SMTP_PORT=587
# Поштова скринька для входу на SMTP-сервер.
SMTP_USER=
# Пароль SMTP або виданий поштовим провайдером пароль застосунку.
SMTP_PASS=
# Адреса відправника: SMTP_USER або дозволений провайдером псевдонім.
MAIL_FROM=
